{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "policyDefinitionName": {
      "type": "string",
      "defaultValue": "kv-ext-arc-windows",
      "minLength": 1,
      "maxLength": 64,
      "metadata": {
        "description": "Name of the subscription-level policy definition. Reusing a name updates the existing definition."
      }
    }
  },
  "variables": {
    "extensionTemplateJson": "{\"$schema\":\"https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#\",\"contentVersion\":\"1.0.0.0\",\"parameters\":{\"machineName\":{\"type\":\"string\"},\"location\":{\"type\":\"string\"},\"certSuffixes\":{\"type\":\"string\"},\"vaultName\":{\"type\":\"string\"},\"pollingIntervalInS\":{\"type\":\"string\"}},\"variables\":{\"suffixes\":\"[split(parameters('certSuffixes'), ',')]\",\"secretHost\":\"[toLower(replace(parameters('machineName'), '.', '-'))]\",\"copy\":[{\"name\":\"certs\",\"count\":\"[length(variables('suffixes'))]\",\"input\":{\"url\":\"[concat('https://', parameters('vaultName'), '.vault.azure.net/secrets/', toLower(trim(variables('suffixes')[copyIndex('certs')])), '-', variables('secretHost'))]\",\"certificateStoreName\":\"MY\",\"certificateStoreLocation\":\"LocalMachine\",\"linkOnRenewal\":true}}]},\"resources\":[{\"type\":\"Microsoft.HybridCompute/machines/extensions\",\"apiVersion\":\"2022-03-10\",\"name\":\"[concat(parameters('machineName'), '/KeyVaultForWindows')]\",\"location\":\"[parameters('location')]\",\"properties\":{\"publisher\":\"Microsoft.Azure.KeyVault\",\"type\":\"KeyVaultForWindows\",\"autoUpgradeMinorVersion\":true,\"settings\":{\"secretsManagementSettings\":{\"pollingIntervalInS\":\"[parameters('pollingIntervalInS')]\",\"observedCertificates\":\"[variables('certs')]\"},\"authenticationSettings\":{\"msiEndpoint\":\"http://localhost:40342/metadata/identity/oauth2/token\"}}}}]}"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2023-04-01",
      "name": "[parameters('policyDefinitionName')]",
      "properties": {
        "displayName": "Deploy Key Vault extension to Arc Windows servers (tag-driven secrets)",
        "description": "Installs the KeyVaultForWindows extension on tagged Arc-enabled Windows servers to monitor per-machine Key Vault secrets.",
        "policyType": "Custom",
        "mode": "Indexed",
        "parameters": {
          "effect": {
            "type": "String",
            "metadata": {
              "displayName": "Effect",
              "description": "DeployIfNotExists installs the extension; AuditIfNotExists only reports."
            },
            "allowedValues": [ "DeployIfNotExists", "AuditIfNotExists", "Disabled" ],
            "defaultValue": "DeployIfNotExists"
          },
          "vaultName": {
            "type": "String",
            "metadata": {
              "displayName": "Key Vault name",
              "description": "Name of the Key Vault (not the full URL), for example kv-ocscerts."
            }
          },
          "tagName": {
            "type": "String",
            "metadata": {
              "displayName": "Tag name",
              "description": "Tag on the Arc machine holding a comma-separated list of secret prefixes, for example iis,rdp,sql. Machines without this tag are ignored."
            },
            "defaultValue": "KvCertSecrets"
          },
          "pollingIntervalInS": {
            "type": "String",
            "metadata": {
              "displayName": "Polling interval (seconds)"
            },
            "defaultValue": "3600"
          }
        },
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.HybridCompute/machines"
              },
              {
                "field": "Microsoft.HybridCompute/machines/osName",
                "equals": "windows"
              },
              {
                "field": "[[concat('tags[', parameters('tagName'), ']')]",
                "exists": "true"
              }
            ]
          },
          "then": {
            "effect": "[[parameters('effect')]",
            "details": {
              "type": "Microsoft.HybridCompute/machines/extensions",
              "roleDefinitionIds": [
                "/providers/microsoft.authorization/roleDefinitions/cd570a14-e51a-42ad-bac8-bafd67325302"
              ],
              "existenceCondition": {
                "allOf": [
                  {
                    "field": "Microsoft.HybridCompute/machines/extensions/type",
                    "equals": "KeyVaultForWindows"
                  },
                  {
                    "field": "Microsoft.HybridCompute/machines/extensions/publisher",
                    "equals": "Microsoft.Azure.KeyVault"
                  }
                ]
              },
              "deployment": {
                "properties": {
                  "mode": "incremental",
                  "parameters": {
                    "machineName": {
                      "value": "[[field('name')]"
                    },
                    "location": {
                      "value": "[[field('location')]"
                    },
                    "certSuffixes": {
                      "value": "[[field(concat('tags[', parameters('tagName'), ']'))]"
                    },
                    "vaultName": {
                      "value": "[[parameters('vaultName')]"
                    },
                    "pollingIntervalInS": {
                      "value": "[[parameters('pollingIntervalInS')]"
                    }
                  },
                  "template": "[json(variables('extensionTemplateJson'))]"
                }
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "policyDefinitionId": {
      "type": "string",
      "value": "[subscriptionResourceId('Microsoft.Authorization/policyDefinitions', parameters('policyDefinitionName'))]"
    }
  }
}
