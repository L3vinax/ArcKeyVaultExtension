{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "automationResourceGroupName": {
      "type": "string",
      "minLength": 1,
      "metadata": { "description": "Existing resource group in the selected subscription for the Automation account." }
    },
    "automationAccountName": {
      "type": "string",
      "minLength": 6,
      "maxLength": 50,
      "metadata": { "description": "Name of a NEW, dedicated Automation account. Do not reuse an account deployed for another assignment or target group." }
    },
    "targetResourceGroupName": {
      "type": "string",
      "minLength": 1,
      "metadata": { "description": "Existing resource group containing the Arc machines, in the selected subscription." }
    },
    "policyAssignmentId": {
      "type": "string",
      "minLength": 1,
      "metadata": { "description": "Full resource ID of the existing standalone DeployIfNotExists policy assignment, including /providers/Microsoft.Authorization/policyAssignments/<name>. The assignment must be scoped to the selected subscription or target resource group. Do not enter only a subscription/resource-group scope, assignment name, or display name." }
    },
    "runbookContentUri": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/L3vinax/ArcKeyVaultExtension/main/scripts/Invoke-KvCertRemediation.ps1",
      "metadata": { "description": "Public HTTPS URL of the trusted runbook source. Use your fork's URL if needed, or a commit-pinned URL for reproducible deployments." }
    }
  },
  "variables": {
    "automationResourceGroupId": "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('automationResourceGroupName'))]",
    "automationAccountId": "[extensionResourceId(variables('automationResourceGroupId'), 'Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]",
    "targetScope": "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('targetResourceGroupName'))]",
    "policyAssignmentId": "[parameters('policyAssignmentId')]",
    "automationDeploymentName": "[concat('kv-cert-account-', uniqueString(variables('automationAccountId')))]",
    "automationDeploymentId": "[extensionResourceId(variables('automationResourceGroupId'), 'Microsoft.Resources/deployments', variables('automationDeploymentName'))]",
    "permissionsDeploymentName": "[concat('kv-cert-permissions-', uniqueString(variables('automationAccountId')))]",
    "permissionsDeploymentId": "[extensionResourceId(variables('targetScope'), 'Microsoft.Resources/deployments', variables('permissionsDeploymentName'))]",
    "subscriptionPermissionsDeploymentName": "[concat('kv-cert-reader-', uniqueString(variables('automationAccountId')))]",
    "subscriptionPermissionsDeploymentId": "[subscriptionResourceId('Microsoft.Resources/deployments', variables('subscriptionPermissionsDeploymentName'))]",
    "assignmentAtSubscription": "[equals(toLower(variables('policyAssignmentId')), toLower(subscriptionResourceId('Microsoft.Authorization/policyAssignments', last(split(variables('policyAssignmentId'), '/')))))]",
    "assignmentRelativeScope": "[concat('Microsoft.Authorization/policyAssignments/', last(split(variables('policyAssignmentId'), '/')))]",
    "scheduleDeploymentName": "[concat('kv-cert-schedule-', uniqueString(variables('automationAccountId')))]",
    "policyContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '36243c78-bf99-498c-9df9-86d9f8d28608')]",
    "readerRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[variables('automationDeploymentName')]",
      "resourceGroup": "[parameters('automationResourceGroupName')]",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": { "scope": "inner" },
        "parameters": {
          "accountName": { "value": "[parameters('automationAccountName')]" },
          "location": { "value": "[deployment().location]" },
          "runbookContentUri": { "value": "[parameters('runbookContentUri')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "accountName": { "type": "string" },
            "location": { "type": "string" },
            "runbookContentUri": { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.Automation/automationAccounts",
              "apiVersion": "2023-11-01",
              "name": "[parameters('accountName')]",
              "location": "[parameters('location')]",
              "identity": { "type": "SystemAssigned" },
              "properties": { "sku": { "name": "Basic" } }
            },
            {
              "type": "Microsoft.Automation/automationAccounts/runtimeEnvironments",
              "apiVersion": "2024-10-23",
              "name": "[concat(parameters('accountName'), '/KvCertRemediation-PowerShell74')]",
              "location": "[parameters('location')]",
              "dependsOn": [ "[resourceId('Microsoft.Automation/automationAccounts', parameters('accountName'))]" ],
              "properties": {
                "description": "PowerShell 7.4 environment dedicated to certificate policy remediation.",
                "runtime": { "language": "PowerShell", "version": "7.4" }
              }
            },
            {
              "type": "Microsoft.Automation/automationAccounts/runtimeEnvironments/packages",
              "apiVersion": "2024-10-23",
              "name": "[concat(parameters('accountName'), '/KvCertRemediation-PowerShell74/Az.Accounts')]",
              "location": "[parameters('location')]",
              "dependsOn": [ "[resourceId('Microsoft.Automation/automationAccounts/runtimeEnvironments', parameters('accountName'), 'KvCertRemediation-PowerShell74')]" ],
              "properties": {
                "contentLink": { "uri": "https://www.powershellgallery.com/api/v2/package/Az.Accounts/5.3.3" }
              }
            },
            {
              "type": "Microsoft.Automation/automationAccounts/runbooks",
              "apiVersion": "2024-10-23",
              "name": "[concat(parameters('accountName'), '/Invoke-KvCertRemediation')]",
              "location": "[parameters('location')]",
              "dependsOn": [ "[resourceId('Microsoft.Automation/automationAccounts/runtimeEnvironments/packages', parameters('accountName'), 'KvCertRemediation-PowerShell74', 'Az.Accounts')]" ],
              "properties": {
                "runbookType": "PowerShell",
                "runtimeEnvironment": "KvCertRemediation-PowerShell74",
                "description": "Remediates the existing certificate policy assignment with ReEvaluateCompliance using managed identity.",
                "logProgress": true,
                "logVerbose": false,
                "publishContentLink": { "uri": "[parameters('runbookContentUri')]" }
              }
            }
          ],
          "outputs": {
            "principalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Automation/automationAccounts', parameters('accountName')), '2023-11-01', 'Full').identity.principalId]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[variables('permissionsDeploymentName')]",
      "resourceGroup": "[parameters('targetResourceGroupName')]",
      "dependsOn": [ "[variables('automationDeploymentId')]" ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": { "scope": "inner" },
        "parameters": {
          "principalId": { "value": "[reference(variables('automationDeploymentId'), '2022-09-01').outputs.principalId.value]" },
          "contributorRoleId": { "value": "[variables('policyContributorRoleId')]" },
          "readerRoleId": { "value": "[variables('readerRoleId')]" },
          "policyAssignmentId": { "value": "[variables('policyAssignmentId')]" },
          "assignmentRelativeScope": { "value": "[variables('assignmentRelativeScope')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "principalId": { "type": "string" },
            "contributorRoleId": { "type": "string" },
            "readerRoleId": { "type": "string" },
            "policyAssignmentId": { "type": "string" },
            "assignmentRelativeScope": { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(toLower(resourceGroup().id), toLower(parameters('principalId')), toLower(parameters('contributorRoleId')))]",
              "properties": {
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[parameters('contributorRoleId')]"
              }
            },
            {
              "condition": "[equals(toLower(parameters('policyAssignmentId')), toLower(resourceId('Microsoft.Authorization/policyAssignments', last(split(parameters('policyAssignmentId'), '/')))))]",
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(toLower(parameters('policyAssignmentId')), toLower(parameters('principalId')), toLower(parameters('readerRoleId')))]",
              "scope": "[parameters('assignmentRelativeScope')]",
              "properties": {
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[parameters('readerRoleId')]"
              }
            }
          ]
        }
      }
    },
    {
      "condition": "[variables('assignmentAtSubscription')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[variables('subscriptionPermissionsDeploymentName')]",
      "subscriptionId": "[subscription().subscriptionId]",
      "location": "[deployment().location]",
      "dependsOn": [ "[variables('automationDeploymentId')]" ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": { "scope": "inner" },
        "parameters": {
          "principalId": { "value": "[reference(variables('automationDeploymentId'), '2022-09-01').outputs.principalId.value]" },
          "readerRoleId": { "value": "[variables('readerRoleId')]" },
          "policyAssignmentId": { "value": "[variables('policyAssignmentId')]" },
          "assignmentRelativeScope": { "value": "[variables('assignmentRelativeScope')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "principalId": { "type": "string" },
            "readerRoleId": { "type": "string" },
            "policyAssignmentId": { "type": "string" },
            "assignmentRelativeScope": { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(toLower(parameters('policyAssignmentId')), toLower(parameters('principalId')), toLower(parameters('readerRoleId')))]",
              "scope": "[parameters('assignmentRelativeScope')]",
              "properties": {
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[parameters('readerRoleId')]"
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[variables('scheduleDeploymentName')]",
      "resourceGroup": "[parameters('automationResourceGroupName')]",
      "dependsOn": [
        "[variables('automationDeploymentId')]",
        "[variables('permissionsDeploymentId')]",
        "[variables('subscriptionPermissionsDeploymentId')]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": { "scope": "inner" },
        "parameters": {
          "accountName": { "value": "[parameters('automationAccountName')]" },
          "subscriptionId": { "value": "[subscription().subscriptionId]" },
          "targetResourceGroupName": { "value": "[parameters('targetResourceGroupName')]" },
          "policyAssignmentId": { "value": "[variables('policyAssignmentId')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "accountName": { "type": "string" },
            "subscriptionId": { "type": "string" },
            "targetResourceGroupName": { "type": "string" },
            "policyAssignmentId": { "type": "string" },
            "scheduleStartTime": { "type": "string", "defaultValue": "[dateTimeAdd(utcNow(), 'PT10M')]" }
          },
          "resources": [
            {
              "type": "Microsoft.Automation/automationAccounts/schedules",
              "apiVersion": "2023-11-01",
              "name": "[concat(parameters('accountName'), '/KvCertRemediation-Hourly')]",
              "properties": {
                "description": "Hourly fresh compliance discovery and remediation for one assignment and target resource group.",
                "frequency": "Hour",
                "interval": 1,
                "startTime": "[parameters('scheduleStartTime')]",
                "timeZone": "UTC"
              }
            },
            {
              "type": "Microsoft.Automation/automationAccounts/jobSchedules",
              "apiVersion": "2023-11-01",
              "name": "[concat(parameters('accountName'), '/', guid(resourceId('Microsoft.Automation/automationAccounts', parameters('accountName')), 'Invoke-KvCertRemediation', 'KvCertRemediation-Hourly'))]",
              "dependsOn": [ "[resourceId('Microsoft.Automation/automationAccounts/schedules', parameters('accountName'), 'KvCertRemediation-Hourly')]" ],
              "properties": {
                "runbook": { "name": "Invoke-KvCertRemediation" },
                "schedule": { "name": "KvCertRemediation-Hourly" },
                "parameters": {
                  "SubscriptionId": "[parameters('subscriptionId')]",
                  "ResourceGroupName": "[parameters('targetResourceGroupName')]",
                  "PolicyAssignmentId": "[parameters('policyAssignmentId')]"
                }
              }
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "automationAccountId": { "type": "string", "value": "[variables('automationAccountId')]" },
    "policyAssignmentId": { "type": "string", "value": "[variables('policyAssignmentId')]" },
    "targetScope": { "type": "string", "value": "[variables('targetScope')]" }
  }
}
